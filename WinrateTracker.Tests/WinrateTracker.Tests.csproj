<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Link in the pure logic files you want to test. Do NOT ProjectReference the mod
      project: it references sts2.dll, which cannot be loaded outside the game.
      Keep game-independent calculations in their own files so they can be linked here.
    -->
    <Compile Include="..\WinrateTrackerCode\RunRecord.cs" Link="RunRecord.cs" />
    <Compile Include="..\WinrateTrackerCode\RunParser.cs" Link="RunParser.cs" />
    <Compile Include="..\WinrateTrackerCode\RunFilter.cs" Link="RunFilter.cs" />
    <Compile Include="..\WinrateTrackerCode\WinrateReport.cs" Link="WinrateReport.cs" />
    <Compile Include="..\WinrateTrackerCode\Format.cs" Link="Format.cs" />
    <Compile Include="..\WinrateTrackerCode\ReportTables.cs" Link="ReportTables.cs" />
    <Compile Include="..\WinrateTrackerCode\HomePanel.cs" Link="HomePanel.cs" />
    <Compile Include="..\WinrateTrackerCode\ArtKey.cs" Link="ArtKey.cs" />
    <Compile Include="..\WinrateTrackerCode\GameData.cs" Link="GameData.cs" />
    <Compile Include="..\WinrateTrackerCode\PickFilter.cs" Link="PickFilter.cs" />

    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" PrivateAssets="all" />
  </ItemGroup>
</Project>
