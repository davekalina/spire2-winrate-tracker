# .NET build output
bin/
obj/
publish/

# Godot editor/import cache
.godot/

# Machine-specific build configuration (copy Directory.Build.props.example)
Directory.Build.props

# Staged Workshop upload payload; regenerate with scripts/package-workshop.ps1.
# workshop/mod_id.txt is deliberately NOT ignored: it is the only link between
# this repository and the published Steam Workshop item.
workshop/content/

# User- and machine-specific IDE files
.vs/
.idea/
*.user
*.suo
*.csproj.user
# IDE-generated solution files; each project builds from its own .csproj.
*.sln

# Local secrets
.env
.env.*
!.env.example

# Local copy of the Claude Design handoff bundle, kept for reference while the
# refresh is in flight. The HTML is a prototype, not code, and the PNGs beside it
# are the game's own art; neither is redistributable.
.design/

# Written beside the uploader each time it runs. A transcript of a publish, not
# something the repository needs.
mod-uploader.log
